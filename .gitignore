# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Go service build artifact. `service/service` is what `go build` produces
# when run from inside service/ without -o, which is easy to do by accident
# (and is a ~17MB binary), so it's ignored alongside the named variants.
service/ifda-service
service/fwana-service
service/service

# Service runtime data (triage state, uploads, users.json password hashes)
service/data/
service/.data/
service/jobs/
service/users.json
service/ai.key
service/ai.key.bak-*
service/reports.db
service/reports.db-shm
service/reports.db-wal
service/*.log

# Editor / OS
.DS_Store
*.swp

# Harness / local tooling
.claude/
claude.sh
