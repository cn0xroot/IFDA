{
  "schema": "ifda-secret-rules/1",
  "version": "2026.06.10",
  "description": "Externalized, independently-updatable secret signatures (NFR-USE-2). Each rule flags a structured high-entropy provider token by shape. Values are redacted in evidence by the scanner.",
  "rules": [
    {
      "id": "aws-access-key",
      "name": "AWS access key id",
      "vuln_class": "cloud_key",
      "severity": "high",
      "confidence": 0.8,
      "regex": "\\bAKIA[0-9A-Z]{16}\\b",
      "remediation": "Remove and rotate the AWS credential."
    },
    {
      "id": "aws-secret-key",
      "name": "AWS secret access key (assignment)",
      "vuln_class": "cloud_key",
      "severity": "high",
      "confidence": 0.7,
      "regex": "(?i)aws_secret_access_key\\s*[=:]\\s*[\"']?([A-Za-z0-9/+]{40})",
      "remediation": "Remove and rotate the AWS secret key."
    },
    {
      "id": "github-pat",
      "name": "GitHub personal access token",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.85,
      "regex": "\\bghp_[A-Za-z0-9]{36,}\\b",
      "remediation": "Remove the token and rotate the GitHub credential."
    },
    {
      "id": "github-fine-grained",
      "name": "GitHub fine-grained token",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.85,
      "regex": "\\bgithub_pat_[0-9A-Za-z_]{60,}\\b",
      "remediation": "Revoke the GitHub fine-grained token."
    },
    {
      "id": "openai-key",
      "name": "OpenAI API key",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.85,
      "regex": "\\bsk-[A-Za-z0-9]{20,}\\b",
      "remediation": "Remove and rotate the API key."
    },
    {
      "id": "google-api-key",
      "name": "Google API key",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.8,
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "remediation": "Remove and rotate the Google API key."
    },
    {
      "id": "jwt",
      "name": "JSON Web Token",
      "vuln_class": "api_token",
      "severity": "medium",
      "confidence": 0.6,
      "regex": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{6,}",
      "remediation": "Treat as a live credential; rotate the signing key."
    },
    {
      "id": "slack-token",
      "name": "Slack token",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.85,
      "regex": "\\bxox[baprs]-[0-9A-Za-z-]{10,}",
      "remediation": "Revoke the Slack token."
    },
    {
      "id": "stripe-secret-key",
      "name": "Stripe secret key",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.85,
      "regex": "\\b[rs]k_live_[0-9A-Za-z]{24,}\\b",
      "remediation": "Roll the Stripe key."
    },
    {
      "id": "google-oauth-secret",
      "name": "Google OAuth client secret",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.7,
      "regex": "\\bGOCSPX-[A-Za-z0-9_-]{20,}\\b",
      "remediation": "Rotate the OAuth client secret."
    },
    {
      "id": "twilio-key",
      "name": "Twilio API key",
      "vuln_class": "api_token",
      "severity": "high",
      "confidence": 0.75,
      "regex": "\\bSK[0-9a-fA-F]{32}\\b",
      "remediation": "Revoke the Twilio key."
    }
  ]
}
